# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://jobfit:jobfit@localhost:5432/jobfit

# Claude, used to extract requirements from a posting
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Notion (optional). Leave blank to read postings from data/postings/*.txt instead.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# Matching: a requirement counts as "supported" when its best bullet scores at or above this.
# Tune it with `npm run eval` instead of guessing.
MATCH_THRESHOLD=0.35
TOP_K=3
