{
  "name": "job-fit-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Match job posting requirements to resume bullets with embeddings + retrieval, and measure it with evals.",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:init": "tsx src/db/init.ts",
    "ingest:resume": "tsx src/cli.ts ingest-resume",
    "ingest:postings": "tsx src/cli.ts ingest-postings",
    "match": "tsx src/cli.ts match",
    "eval:template": "tsx evals/template.ts",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit",
    "web": "tsx src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@notionhq/client": "^5.28.0",
    "dotenv": "^18.0.9",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "zod": "^4.6.7"
  }
}
